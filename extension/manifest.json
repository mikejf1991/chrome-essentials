{
  "manifest_version": 3,
  "name": "Essentials",
  "description": "Launch Essentials and custom saved groups, keep their order, and restore tabs at their last in-app address.",
  "version": "0.2.2",
  "minimum_chrome_version": "150",
  "permissions": ["tabs", "tabGroups", "storage", "contextMenus", "webNavigation", "alarms"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {
    "default_title": "Open Essentials",
    "default_icon": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}
  },
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "options_page": "options.html",
  "incognito": "not_allowed",
  "commands": {
    "_execute_action": {"description": "Open Essentials"}
  }
}
